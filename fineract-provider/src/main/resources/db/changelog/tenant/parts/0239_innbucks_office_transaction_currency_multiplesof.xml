<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- m_office_transaction was created WITHOUT currency_multiplesof, but
         the OfficeTransaction entity embeds MonetaryCurrency, whose mapping
         includes it (MonetaryCurrency.java:37) - so every JPA write of an
         inter-office cash transfer generated SQL PostgreSQL refused:
         'column "currency_multiplesof" of relation "m_office_transaction"
         does not exist', surfaced as a 403 by the data-integrity mapper.
         Nullable SMALLINT, exactly as the embeddable maps it and as every
         other table carrying MonetaryCurrency defines it. -->
    <changeSet author="innbucks" id="innbucks-office-transaction-currency-multiplesof">
        <addColumn tableName="m_office_transaction">
            <column name="currency_multiplesof" type="SMALLINT"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
