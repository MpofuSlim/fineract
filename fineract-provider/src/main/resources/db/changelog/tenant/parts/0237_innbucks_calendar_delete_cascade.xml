<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- Calendar delete could NEVER succeed on this schema: creating a
         calendar always creates an m_calendar_instance row, and editing one
         writes m_calendar_history rows - and BOTH foreign keys back to
         m_calendar were RESTRICT, so DELETE /calendars answered a
         data-integrity 403 every time (confirmed on the ZW cell, 2026-09-08;
         clearing a stuck calendar took manual SQL through both tables).
         Instance and history rows have no life of their own after their
         calendar is gone, so CASCADE is the correct ownership semantic. -->
    <changeSet author="innbucks" id="innbucks-calendar-instance-delete-cascade">
        <dropForeignKeyConstraint baseTableName="m_calendar_instance"
                                  constraintName="FK_m_calendar_m_calendar_instance"/>
        <addForeignKeyConstraint baseColumnNames="calendar_id" baseTableName="m_calendar_instance"
                                 constraintName="FK_m_calendar_m_calendar_instance" deferrable="false"
                                 initiallyDeferred="false" onDelete="CASCADE" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_calendar" validate="true"/>
    </changeSet>

    <changeSet author="innbucks" id="innbucks-calendar-history-delete-cascade">
        <dropForeignKeyConstraint baseTableName="m_calendar_history"
                                  constraintName="FK_m_calendar_m_calendar_history"/>
        <addForeignKeyConstraint baseColumnNames="calendar_id" baseTableName="m_calendar_history"
                                 constraintName="FK_m_calendar_m_calendar_history" deferrable="false"
                                 initiallyDeferred="false" onDelete="CASCADE" onUpdate="RESTRICT"
                                 referencedColumnNames="id" referencedTableName="m_calendar" validate="true"/>
    </changeSet>
</databaseChangeLog>
