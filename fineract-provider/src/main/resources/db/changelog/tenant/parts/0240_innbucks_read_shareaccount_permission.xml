<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- GET /v1/search returns share accounts only to a user who can read
         them: ALL_FUNCTIONS, ALL_FUNCTIONS_READ or READ_SHAREACCOUNT, as for
         every other resource type it searches (READ_CLIENT, READ_LOAN, ...).
         READ_SHAREACCOUNT was never seeded - share accounts are the one
         searched type without a read permission - so no role short of the
         all-functions ones could be granted share results. Grouped with the
         other share account codes; no role holds it until an operator grants
         it. -->
    <changeSet author="innbucks" id="innbucks-read-shareaccount-permission">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM m_permission WHERE code = 'READ_SHAREACCOUNT'
            </sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="SHAREACCOUNT"/>
            <column name="code" value="READ_SHAREACCOUNT"/>
            <column name="entity_name" value="SHAREACCOUNT"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
