<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <!-- ZWG (Zimbabwe Gold / ZiG) is absent from the 164-currency seed; the
         only Zimbabwe entry is the long-dead ZWD, so a ZW cell cannot select
         its own legal tender for products. /v1/currencies has no create API -
         m_currency rows only ever come from migrations. Explicit id 165
         (seeds use explicit ids 1-164 and never advance the sequence, so an
         id-less insert could collide at 1). ISO 4217: ZWG, minor unit 2. -->
    <changeSet author="innbucks" id="innbucks-add-zwg-currency">
        <insert tableName="m_currency">
            <column name="id" valueNumeric="165"/>
            <column name="code" value="ZWG"/>
            <column name="decimal_places" valueNumeric="2"/>
            <column name="currency_multiplesof"/>
            <column name="display_symbol" value="ZiG"/>
            <column name="name" value="Zimbabwe Gold"/>
            <column name="internationalized_name_code" value="currency.ZWG"/>
        </insert>
    </changeSet>
</databaseChangeLog>
